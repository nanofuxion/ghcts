{
  "purpose": "Minimal GHCJS-compatible compiler extraction for npm/WASI experiments",
  "sourceTrees": {
    "ghc": "../references/ghc",
    "ghcjs": "../references/ghcjs"
  },
  "entrypoint": "references/ghcjs/src-bin/Main.hs -> Compiler.Program.main",
  "backendBoundary": [
    "references/ghcjs/src/Compiler/GhcjsHooks.hs",
    "references/ghcjs/src/Compiler/GhcjsProgram.hs",
    "references/ghcjs/src/Gen2/Generator.hs",
    "references/ghcjs/src/Gen2/Linker.lhs",
    "references/ghcjs/src/Gen2/Printer.hs",
    "references/ghcjs/src/Gen2/Rts.hs",
    "references/ghcjs/src/Gen2/Foreign.hs"
  ],
  "initiallyExcluded": [
    "ghcjs-boot",
    "haddock",
    "ghcjs-pkg",
    "Template Haskell",
    "profiling",
    "threaded runtime",
    "native foreign libraries",
    "optimizer"
  ],
  "compatibilityFixtures": [
    "../references/miso-lynx/examples/counter/Main.hs",
    "../references/misogram/src"
  ],
  "toolchain": {
    "hostGhcObserved": "9.6.7",
    "legacyGhcjsVersion": "8.10.7",
    "wasmLowering": "Binaryen wasm2js"
  }
}
