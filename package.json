{
  "name": "ghcts",
  "version": "0.1.0",
  "description": "GHC's JavaScript backend, as a JavaScript program: GHC compiled to JS by its own JS backend, with a ghc-shaped CLI",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ghcts": "./dist/cli.js"
  },
  "files": [
    "dist",
    "build",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp dist/cabal.js playground/cabal.js",
    "build:compiler": "npm run build && node build/build-compiler.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "build:lynx": "node scripts/build-lynx-bundles.mjs"
  },
  "dependencies": {
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "wrangler": "^4.129.0"
  },
  "engines": {
    "node": ">=20"
  }
}
